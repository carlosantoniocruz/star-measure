<?xml version="1.0" encoding="utf-8"?>
<!-- Three small seaGreen dots (r 7) in a triangle around a white centre dot
     (r 4.5) — the same reticle motif as the AR overlay — on the lightMauve
     background, well inside the 66dp safe zone, with a darkTyrianBlue ring
     flush with the icon's round edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00B49B"
        android:pathData="M47,34 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#00B49B"
        android:pathData="M64.32,64 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#00B49B"
        android:pathData="M29.68,64 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49.5,54 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <!-- Circular outline, darkTyrianBlue (the main menu's background), flush
         with the icon's edge: the launcher shows the inner 72dp (radius 36)
         of this 108dp canvas, so a 6-wide stroke centred on radius 36 leaves
         an even 3dp band from 33 to the edge, and the rest is masked away.
         The dots reach 27, well clear of it. -->
    <path
        android:strokeColor="#12354E"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M18,54 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />
</vector>
